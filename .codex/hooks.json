{
  "description": "IIRS session context reminder",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"",
            "timeout": 5,
            "additionalContextLimit": 400
          }
        ]
      }
    ]
  }
}
